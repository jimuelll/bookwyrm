# Copy to .env and fill in. Never commit .env (it is gitignored).
# Server-side only: none of these may be exposed to the browser except VITE_* values.

# ---------- Database (docker-compose.yml reads POSTGRES_*) ----------
POSTGRES_USER=bookwyrm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookwyrm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bookwyrm:change-me@localhost:5432/bookwyrm

# ---------- LLM + embeddings (see docs/ARCHITECTURE.md, providers) ----------
# gemini | groq | fake   (fake = canned outputs for tests, no key needed)
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
# gemini | local | fake
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=

# ---------- Uploads & storage ----------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_PAGES=500

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=60

# ---------- API ----------
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ---------- Frontend (exposed to the browser; put these in frontend/.env.local) ----------
VITE_API_URL=http://localhost:8000
