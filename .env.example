# Copy to .env and fill in. Never commit .env (it is gitignored).
# Server-side only: none of these may be exposed to the browser except VITE_* values.

# ---------- Supabase (Auth, Postgres, Storage) ----------
# Supabase dashboard -> Project Settings -> API. See README "Set up Supabase".
SUPABASE_URL=
# Only for projects still using the legacy shared JWT secret (HS256). Leave empty on new projects.
SUPABASE_JWT_SECRET=
# The secret key (Project Settings -> API Keys -> Secret keys: sb_secret_..., or the legacy service_role key).
# The backend uses it only for Storage (the private "documents" bucket, made by `alembic upgrade head`).
# Without it, uploaded PDFs are kept in STORAGE_DIR on this machine instead.
# SERVER-SIDE ONLY: it bypasses every access rule. Never put it in a VITE_* variable or the frontend.
SUPABASE_SECRET_KEY=

# ---------- Optional local database (docker-compose.yml reads POSTGRES_*) ----------
POSTGRES_USER=bookwyrm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookwyrm
POSTGRES_PORT=5432
# The backend's database connection. For Supabase: dashboard -> Connect -> pooler string, pasted as is
# (postgresql://... is fine), with [YOUR-PASSWORD] replaced by your database password. Port 5432
# (session mode) is best; 6543 also works. Server-side only: it contains the database password.
# DATABASE_URL=postgresql://postgres.<project-id>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://bookwyrm:change-me@localhost:5432/bookwyrm

# ---------- LLM + embeddings (see docs/ARCHITECTURE.md, providers) ----------
# gemini | groq | fake   (fake = canned outputs for tests, no key needed)
# The primary provider; the other one is used as a fallback when its key is set.
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# gemini | local | fake
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=

# ---------- Uploads & storage ----------
# Temporary files while an upload is checked and read; also where PDFs are kept if SUPABASE_SECRET_KEY is unset
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_PAGES=500

# ---------- API ----------
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ---------- Frontend (exposed to the browser; put these in frontend/.env.local) ----------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
# The publishable (anon) key. Public by design; NEVER put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
